# ─────────────────────────────────────────────────────────────
# .env.example — copy ไปเป็น .env แล้วแก้ค่า
# ⚠️  ห้าม commit .env และ credentials.json ขึ้น git เด็ดขาด
# ─────────────────────────────────────────────────────────────

# Path ไปยัง credentials.json ที่ดาวน์โหลดจาก Google Cloud Console
# ถ้าไม่ระบุ จะหาที่ ./credentials.json (โฟลเดอร์เดียวกับ script)
GDRIVE_CREDENTIALS_FILE=./credentials.json

# Path ที่จะเก็บ OAuth token (สร้างอัตโนมัติหลัง login ครั้งแรก)
GDRIVE_TOKEN_FILE=./token.json

# Google Drive folder ID ปลายทาง (เปิด Drive → เข้าโฟลเดอร์ → ดู URL → .../folders/<ID>)
# ถ้าเป็น "root" จะอัปโหลดไปที่ My Drive รากโดยตรง
GDRIVE_FOLDER_ID=root

# Path ของ log file (ว่างเปล่า = ไม่เขียน log ไฟล์)
BACKUP_LOG_FILE=./backup.log

# จำนวนวันที่เก็บ backup ไว้ใน Drive (0 = ไม่ลบอัตโนมัติ)
BACKUP_RETENTION_DAYS=0
